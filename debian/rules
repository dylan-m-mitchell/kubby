#!/usr/bin/make -f

PKG_NAME   = kubui
# Build the venv outside the staging tree so debhelper doesn't clean it up.
VENV_BUILD = debian/kubui-venv
VENV_DEST  = debian/$(PKG_NAME)/opt/$(PKG_NAME)

export DH_VERBOSE = 1

%:
	dh $@

# ── build ────────────────────────────────────────────────────────────
# Create a virtualenv with --system-site-packages so pywebview can see
# the system-installed gi (GObject Introspection) bindings that drive
# the GTK/WebKit2 backend.  pip-install kubui itself so the entry-point
# script lands inside the venv.

override_dh_auto_build:
	python3 -m venv --system-site-packages $(VENV_BUILD)
	# --no-build-isolation: use system-installed hatchling (from Build-Depends)
	# instead of downloading it during build.
	# --no-deps: install only kubui's own code here; runtime dependency
	# pywebview is installed in a separate step below (requires network).
	$(VENV_BUILD)/bin/pip install --no-cache-dir --no-build-isolation --no-deps .
	# Install runtime dependencies from vendored wheels (no network needed).
	# pywebview is not packaged in Debian/Ubuntu, so we vendor the wheel.
	$(VENV_BUILD)/bin/pip install --no-cache-dir --no-index --find-links=debian/vendor 'pywebview>=6.2.1'

# ── install ──────────────────────────────────────────────────────────
# Symlink the pip-generated entry-point into /usr/bin so the user can
# run `kubui` without activating the venv.

override_dh_auto_install:
	mkdir -p $(VENV_DEST)
	cp -a $(VENV_BUILD)/* $(VENV_DEST)/
	# Rewrite venv shebangs: the copied scripts still reference the
	# build-time python path; fix them to use the installed venv path.
	find $(VENV_DEST)/bin -maxdepth 1 -type f -exec grep -l '^#!.*$(VENV_BUILD)' {} + 2>/dev/null | \
		xargs -r sed -i '1s|^#!.*python[0-9.]*|#!/opt/$(PKG_NAME)/bin/python3|'
	mkdir -p debian/$(PKG_NAME)/usr/bin
	ln -sf /opt/$(PKG_NAME)/bin/kubui debian/$(PKG_NAME)/usr/bin/kubui

# ── clean ────────────────────────────────────────────────────────────

override_dh_auto_clean:
	rm -rf $(VENV_BUILD)

# ── tests ────────────────────────────────────────────────────────────

override_dh_auto_test:
	: # no test suite yet
