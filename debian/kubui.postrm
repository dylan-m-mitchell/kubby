#!/bin/sh
# postrm script for kubui

set -e

MARKER_FILE="/opt/kubui/.installed-tools"

case "$1" in
    purge)
        # Remove CLI tool symlinks from /usr/bin (the actual binaries
        # live under /opt/kubui/ which is removed at the end).
        if [ -f "${MARKER_FILE}" ]; then
            while IFS= read -r bin; do
                [ -z "$bin" ] && continue
                case "$bin" in
                    kubectl|helm|minikube) ;;
                    *) echo "kubui: ignoring unexpected marker entry: $bin" >&2; continue ;;
                esac
                if [ -L "/usr/bin/${bin}" ]; then
                    echo "kubui: removing /usr/bin/${bin} symlink"
                    rm -f "/usr/bin/${bin}"
                fi
            done < "${MARKER_FILE}"
        else
            echo "kubui: no marker file found — skipping CLI tool cleanup"
        fi
        echo "kubui: removing /opt/kubui ..."
        rm -rf /opt/kubui
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
esac

exit 0
