/* kubby TUI — lazygit-flavored palette and panel chrome. */

$bg: #101418;
$panel-bg: #141a20;
$strip-bg: #1b2430;
$border: #2e3a46;
$border-focus: #58a6ff;
$text: #c9d1d9;
$dim: #768390;
$accent: #79c0ff;

Screen {
    background: $bg;
    color: $text;
}

/* header ------------------------------------------------------------ */
#status {
    height: 1;
    background: $strip-bg;
    padding: 0 1;
}

/* main region ------------------------------------------------------- */
#body {
    height: 1fr;
}

#sidebar {
    width: 34;
    min-width: 20;
    margin: 0 1 0 0;
}

.panel {
    background: $panel-bg;
    border: round $border;
    border-title-color: $dim;
    border-subtitle-color: $dim;
    height: 1fr;
}

.panel:focus {
    border: round $border-focus;
    border-title-color: $accent;
    border-title-style: bold;
}

#minikube {
    height: 6;
}

/* log --------------------------------------------------------------- */
#log {
    height: 10;
    background: $panel-bg;
    border: round $border;
    border-title-color: $dim;
    margin: 1 0 0 0;
}

/* keybar ------------------------------------------------------------ */
#keybar {
    height: 1;
    background: $strip-bg;
    padding: 0 1;
}

/* help overlay ------------------------------------------------------ */
HelpScreen {
    align: center middle;
    background: $bg 70%;
}

#help-box {
    width: 64;
    height: auto;
    max-height: 90%;
    border: round $border-focus;
    background: $panel-bg;
    padding: 1 2;
}
